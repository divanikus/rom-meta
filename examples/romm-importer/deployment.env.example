# Copy as deployment.env on the server; replace these with existing native paths.
ROMM_CONFIG_DIR=/path/to/existing/romm/config
ROMM_ROMS_DIR=/path/to/existing/platforms
ROMM_RESOURCES_DIR=/path/to/existing/hdd/romm/resources
ROMMETA_WORK_DIR=/path/to/rommeta/job-work
ROMM_NETWORK=existing-romm-network

# Match the actual native RomM run-as identity; use the share owner for SMB storage.
ROMM_UID=568
ROMM_GID=568
